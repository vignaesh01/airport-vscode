{
  "name": "airport",
  "displayName": "Airport",
  "description": "Run Claude Code, Codex, Devin, Antigravity and other AI coding agents side by side in VS Code terminals across multiple workspaces in a single window — without losing track of who needs you.",
  "version": "0.1.2",
  "publisher": "VignaeshRamA",
  "repository": "https://github.com/vignaesh01/airport-vscode",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "airport",
          "title": "Airport",
          "icon": "resources/airport.svg"
        }
      ]
    },
    "views": {
      "airport": [
        {
          "id": "airport.terminals",
          "name": "Terminals"
        },
        {
          "id": "airport.files",
          "name": "Files"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "airport.files",
        "contents": "Select a terminal to see its files here.",
        "when": "!airport.hasActiveTerminal"
      }
    ],
    "commands": [
      {
        "command": "airport.newTerminal",
        "title": "Airport: New Terminal",
        "icon": "$(add)"
      },
      {
        "command": "airport.closeTerminal",
        "title": "Airport: Close Terminal",
        "icon": "$(close)"
      },
      {
        "command": "airport.renameTerminal",
        "title": "Airport: Rename Terminal",
        "icon": "$(edit)"
      },
      {
        "command": "airport.viewFolder",
        "title": "Airport: Open Folder in File Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "airport.duplicateTerminal",
        "title": "Airport: Duplicate Terminal"
      },
      {
        "command": "airport.duplicateTerminalWithAgent",
        "title": "Airport: Duplicate Terminal with Another AI Agent"
      },
      {
        "command": "airport.selectTerminal",
        "title": "Airport: Open Terminal"
      },
      {
        "command": "airport.turnOffNotifications",
        "title": "Airport: Turn Off Notifications"
      },
      {
        "command": "airport.turnOnNotifications",
        "title": "Airport: Turn On Notifications"
      },
      {
        "command": "airport.turnOffOsNotifications",
        "title": "Airport: Turn Off OS Notifications"
      },
      {
        "command": "airport.turnOnOsNotifications",
        "title": "Airport: Turn On OS Notifications"
      },
      {
        "command": "airport.resumeTerminals",
        "title": "Airport: Resume Previous Terminals"
      },
      {
        "command": "airport.discardResume",
        "title": "Airport: Discard Previous Terminals"
      },
      {
        "command": "airport.file.reveal",
        "title": "Reveal in File Explorer"
      },
      {
        "command": "airport.file.cut",
        "title": "Cut"
      },
      {
        "command": "airport.file.copy",
        "title": "Copy"
      },
      {
        "command": "airport.file.paste",
        "title": "Paste"
      },
      {
        "command": "airport.file.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "airport.file.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "airport.file.rename",
        "title": "Rename..."
      },
      {
        "command": "airport.file.delete",
        "title": "Delete"
      },
      {
        "command": "airport.filesRefresh",
        "title": "Airport: Refresh Files",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "airport.turnOffNotifications",
          "when": "airport.notificationsEnabled"
        },
        {
          "command": "airport.turnOnNotifications",
          "when": "!airport.notificationsEnabled"
        },
        {
          "command": "airport.turnOffOsNotifications",
          "when": "airport.osNotificationsEnabled"
        },
        {
          "command": "airport.turnOnOsNotifications",
          "when": "!airport.osNotificationsEnabled"
        }
      ],
      "view/title": [
        {
          "command": "airport.newTerminal",
          "when": "view == airport.terminals",
          "group": "navigation"
        },
        {
          "command": "airport.turnOffNotifications",
          "when": "view == airport.terminals && airport.notificationsEnabled"
        },
        {
          "command": "airport.turnOnNotifications",
          "when": "view == airport.terminals && !airport.notificationsEnabled"
        },
        {
          "command": "airport.turnOffOsNotifications",
          "when": "view == airport.terminals && airport.osNotificationsEnabled"
        },
        {
          "command": "airport.turnOnOsNotifications",
          "when": "view == airport.terminals && !airport.osNotificationsEnabled"
        },
        {
          "command": "airport.filesRefresh",
          "when": "view == airport.files",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "airport.duplicateTerminal",
          "when": "view == airport.terminals && viewItem == airportTerminal",
          "group": "1_terminalActions@1"
        },
        {
          "command": "airport.duplicateTerminalWithAgent",
          "when": "view == airport.terminals && viewItem == airportTerminal",
          "group": "1_terminalActions@2"
        },
        {
          "command": "airport.renameTerminal",
          "when": "view == airport.terminals && viewItem == airportTerminal",
          "group": "1_terminalActions@3"
        },
        {
          "command": "airport.viewFolder",
          "when": "view == airport.terminals && viewItem == airportTerminal",
          "group": "1_terminalActions@4"
        },
        {
          "command": "airport.closeTerminal",
          "when": "view == airport.terminals && viewItem == airportTerminal",
          "group": "1_terminalActions@5"
        },
        {
          "command": "airport.file.reveal",
          "when": "view == airport.files && viewItem == airportFileEntry",
          "group": "1_reveal@1"
        },
        {
          "command": "airport.file.cut",
          "when": "view == airport.files && viewItem == airportFileEntry",
          "group": "2_cutcopypaste@1"
        },
        {
          "command": "airport.file.copy",
          "when": "view == airport.files && viewItem == airportFileEntry",
          "group": "2_cutcopypaste@2"
        },
        {
          "command": "airport.file.paste",
          "when": "view == airport.files && viewItem == airportFileEntry && airport.fileClipboardHasContent",
          "group": "2_cutcopypaste@3"
        },
        {
          "command": "airport.file.copyPath",
          "when": "view == airport.files && viewItem == airportFileEntry",
          "group": "3_copypath@1"
        },
        {
          "command": "airport.file.copyRelativePath",
          "when": "view == airport.files && viewItem == airportFileEntry",
          "group": "3_copypath@2"
        },
        {
          "command": "airport.file.rename",
          "when": "view == airport.files && viewItem == airportFileEntry",
          "group": "4_modification@1"
        },
        {
          "command": "airport.file.delete",
          "when": "view == airport.files && viewItem == airportFileEntry",
          "group": "4_modification@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run build",
    "test": "vitest run",
    "pretest:integration": "tsc -p tsconfig.test.json",
    "test:integration": "node src/test-integration/runTest.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "vsce package"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "mocha": "^12.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
