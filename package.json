{
  "name": "airport",
  "displayName": "Airport",
  "description": "Run Claude Code, Codex, Devin, and other AI coding agents side by side in VS Code terminals — without losing track of who needs you.",
  "version": "0.1.0",
  "publisher": "airport",
  "private": true,
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "airport",
          "title": "Airport",
          "icon": "resources/airport.svg"
        }
      ]
    },
    "views": {
      "airport": [
        {
          "id": "airport.sessions",
          "name": "Sessions"
        },
        {
          "id": "airport.files",
          "name": "Files"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "airport.files",
        "contents": "Select a session to see its files here.",
        "when": "!airport.hasActiveSession"
      }
    ],
    "commands": [
      {
        "command": "airport.newSession",
        "title": "Airport: New Session",
        "icon": "$(add)"
      },
      {
        "command": "airport.closeSession",
        "title": "Airport: Close Session",
        "icon": "$(close)"
      },
      {
        "command": "airport.renameSession",
        "title": "Airport: Rename Session",
        "icon": "$(edit)"
      },
      {
        "command": "airport.viewFolder",
        "title": "Airport: View Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "airport.selectSession",
        "title": "Airport: Open Session"
      },
      {
        "command": "airport.turnOffNotifications",
        "title": "Airport: Turn Off Notifications"
      },
      {
        "command": "airport.turnOnNotifications",
        "title": "Airport: Turn On Notifications"
      },
      {
        "command": "airport.resumeSessions",
        "title": "Airport: Resume Previous Sessions"
      },
      {
        "command": "airport.discardResume",
        "title": "Airport: Discard Previous Sessions"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "airport.turnOffNotifications",
          "when": "airport.notificationsEnabled"
        },
        {
          "command": "airport.turnOnNotifications",
          "when": "!airport.notificationsEnabled"
        }
      ],
      "view/title": [
        {
          "command": "airport.newSession",
          "when": "view == airport.sessions",
          "group": "navigation"
        },
        {
          "command": "airport.turnOffNotifications",
          "when": "view == airport.sessions && airport.notificationsEnabled"
        },
        {
          "command": "airport.turnOnNotifications",
          "when": "view == airport.sessions && !airport.notificationsEnabled"
        }
      ],
      "view/item/context": [
        {
          "command": "airport.viewFolder",
          "when": "view == airport.sessions && viewItem == airportSession",
          "group": "inline"
        },
        {
          "command": "airport.renameSession",
          "when": "view == airport.sessions && viewItem == airportSession",
          "group": "inline"
        },
        {
          "command": "airport.closeSession",
          "when": "view == airport.sessions && viewItem == airportSession",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run build",
    "test": "vitest run",
    "pretest:integration": "tsc -p tsconfig.test.json",
    "test:integration": "node src/test-integration/runTest.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "vsce package"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "mocha": "^12.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
